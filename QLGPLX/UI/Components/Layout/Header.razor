<header class="main-header">

    <!-- LEFT -->
    <div class="header-left">
        <button class="sidebar-toggle" type="button" @onclick="ToggleSidebar">
            <span></span><span></span><span></span>
        </button>

        <div class="header-breadcrumb">
            <span class="breadcrumb-icon">??</span>
            <span class="breadcrumb-text">@CurrentPage</span>
        </div>
    </div>

    <!-- CENTER -->
    <div class="header-center">
        <div class="header-search">
            <input type="text" placeholder="Tìm ki?m..." />
        </div>
    </div>

    <!-- RIGHT -->
    <div class="header-right">

        <!-- Theme -->
        <button class="header-btn" type="button" title="??i giao di?n" @onclick="ToggleTheme">
            @(Layout?.IsDarkTheme == true ? "??" : "??")
        </button>

        <!-- Notification -->
        <button class="header-btn notif-btn" type="button">
            ?? <span class="notif-badge">3</span>
        </button>

        <!-- User -->
        <div class="header-user" @onclick="ToggleDropdown">
            <div class="user-avatar">A</div>
            <div class="user-info">
                <span class="user-name">Admin</span>
                <span class="user-role">Qu?n tr? viên</span>
            </div>

            @if (showDropdown)
            {
                <div class="user-dropdown" @onclick:stopPropagation>
                    <a href="#">H? s?</a>
                    <a href="#">Cài ??t</a>
                    <hr />
                    <a href="#" @onclick="Logout">??ng xu?t</a>
                </div>
            }
        </div>

    </div>

</header>

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }

    bool showDropdown = false;

    string CurrentPage = "Trang ch?";

    void ToggleSidebar()
    {
        Layout?.ToggleSidebar();
    }

    void ToggleTheme()
    {
        Layout?.ToggleTheme();
    }

    void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    void Logout()
    {
        Console.WriteLine("Logout");
    }
}
