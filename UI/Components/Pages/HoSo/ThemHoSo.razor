@page "/hoso/them"
@using UI.Components.Layout
@using UI.DTO.Hoso
@using UI.DTO.HangGiayPhep
@using UI.DTO.Congdan
@inject HttpClient Http
@inject NavigationManager Navigation

<link href="/css/hoso/them-ho-so.css" rel="stylesheet" />

<div class="page-container">
    <div class="page-header">
        <div class="page-header-content">
            
            <div>
                <h1 class="page-title">Tạo hồ sơ đăng ký GPLX</h1>
                <p class="page-subtitle">Điền thông tin để đăng ký thi giấy phép lái xe</p>
            </div>
        </div>
    </div>

    <div class="form-layout">

        <!-- ================= BƯỚC 1 ================= -->
        <div class="form-section">
            <div class="section-header">
                <div class="step-badge">Bước 1</div>
                <h2 class="section-title">Chọn công dân</h2>
            </div>

            <!-- FILTER MỚI -->
            <div class="filter-bar">

                <div class="filter-group">
                    <label>
                        <input type="checkbox" @bind="onlyNoHoso" @bind:after="OnFilterChanged" />
                        Chưa có hồ sơ
                    </label>
                </div>

                <div class="filter-group">
                    <label>
                        <input type="checkbox" @bind="onlyToday" @bind:after="OnFilterChanged" />
                        Thêm hôm nay
                    </label>
                </div>

                <div class="filter-group">
                    <input type="text" placeholder="Nhập CCCD..." class="filter-input" @bind="searchCCCD"
                           @bind:event="oninput" @bind:after="OnFilterChanged" />
                </div>

                <div class="filter-stats">
                    <span class="stat-badge stat-primary">
                        Đã chọn: <strong>@selectedCongDans.Count</strong>
                    </span>
                </div>

            </div>

            @if (danhSachCongDan == null || danhSachHoSo == null)
            {
                <div class="loading-box">
                    <div class="spinner"></div>
                    <span>Đang tải...</span>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="congdan-table">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" @onchange="ToggleAllCongDan" checked="@IsAllSelected()" />
                                </th>
                                <th>Họ tên</th>
                                <th>CCCD</th>
                                <th>SĐT</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cd in danhSachCongDan)
                            {
                                var hasHoso = HasHosoWithSelectedHang(cd.MaCongDan);
                                var isSelected = selectedCongDans.Contains(cd.MaCongDan);

                                <tr @onclick="() => ToggleCongDan(cd.MaCongDan)">
                                    <td>
                                        <input type="checkbox" checked="@isSelected" disabled="@hasHoso"
                                               @onclick:stopPropagation="true" @onchange="() => ToggleCongDan(cd.MaCongDan)" />
                                    </td>
                                    <td>@cd.HoTen</td>
                                    <td>@cd.Cccd</td>
                                    <td>@cd.SoDienThoai</td>
                                    <td>
                                        @if (hasHoso)
                                        {
                                            <span class="status-badge status-exists">Đã có hồ sơ</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-available">Chưa đăng ký</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        @* ------------ Bước 2 ----------*@

        <!-- ================= BƯỚC 2 ================= -->
        <div class="form-section">
            <div class="section-header">
                <div class="step-badge">Bước 2</div>
                <h2 class="section-title">Chọn hạng giấy phép lái xe</h2>
            </div>
            <div class="section-content">
                @if (danhSachHang == null)
                {
                    <div class="loading-box">Đang tải hạng GPLX...</div>
                }
                else if (!danhSachHang.Any())
                {
                    <div>Không có dữ liệu</div>
                }
                else
                {
                    <div class="hang-grid">
                        @foreach (var hang in danhSachHang)
                        {
                            <div class="hang-border">
                                <div class="hang-card @(selectedMaHang == hang.MaHang ? "selected" : "")"
                                     @onclick="() => SelectHang(hang)">

                                    <div class="hang-badge">@hang.MaHang</div>
                                    <h5>@hang.TenHang</h5>
                                    <p>@hang.LoaiXe</p> @if (selectedMaHang == hang.MaHang) {
                                    <div class="selected-badge">✔</div>
                                }

                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>



    <!-- ================= BƯỚC 3 ================= -->
    <div class="form-section">
        <div class="section-header">
            <div class="step-badge">Bước 3</div>
            <h2 class="section-title">Ghi chú</h2>
        </div>

        <div class="section-content">
            <textarea class="form-textarea" rows="4" placeholder="Nhập ghi chú..." @bind="ghiChu"></textarea>
        </div>
    </div>

    <!-- ACTION -->
    <div class="form-actions">
        <button class="btn-secondary">
            Hủy
        </button>

        <button class="btn-primary" @onclick="SubmitForm" disabled="@(!IsFormValid())">
            Tạo @selectedCongDans.Count hồ sơ
        </button>
    </div>

</div>
</div>

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }

    private List<CongdanDTO>? danhSachCongDan;
    private List<HangGiayPhepDTO>? danhSachHang;
    private List<HosoDTO>? danhSachHoSo;

    private HashSet<int> selectedCongDans = new();
    private string? selectedMaHang;
    private string? ghiChu;

    private bool onlyNoHoso = false;
    private bool onlyToday = false;
    private string searchCCCD = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        danhSachHang = await Http.GetFromJsonAsync<List<HangGiayPhepDTO>>("api/HangGiayPhep");
        danhSachHoSo = await Http.GetFromJsonAsync<List<HosoDTO>>("api/Hoso");

        await LoadCongDan();
    }

    private async Task LoadCongDan()
    {
        if (!string.IsNullOrWhiteSpace(searchCCCD))
        {
            onlyNoHoso = false;
            onlyToday = false;

            danhSachCongDan = await Http.GetFromJsonAsync<List<CongdanDTO>>(
                $"api/CongDan/search?cccd={searchCCCD}");
        }
        else if (onlyNoHoso)
        {
            danhSachCongDan = await Http.GetFromJsonAsync<List<CongdanDTO>>(
                "api/CongDan/chua-co-hoso");
        }
        else if (onlyToday)
        {
            danhSachCongDan = await Http.GetFromJsonAsync<List<CongdanDTO>>(
                "api/CongDan/hom-nay");
        }
        else
        {
            danhSachCongDan = await Http.GetFromJsonAsync<List<CongdanDTO>>(
                "api/CongDan");
        }
    }

    private async Task OnFilterChanged()
    {
        await LoadCongDan();
    }

    private bool HasHosoWithSelectedHang(int id)
    {
        if (string.IsNullOrEmpty(selectedMaHang)) return false;

        return danhSachHoSo?.Any(h =>
            h.MaCongDan == id &&
            h.MaHang == selectedMaHang) ?? false;
    }

    private void ToggleCongDan(int id)
    {
        if (HasHosoWithSelectedHang(id)) return;

        if (selectedCongDans.Contains(id))
            selectedCongDans.Remove(id);
        else
            selectedCongDans.Add(id);
    }

    private void ToggleAllCongDan(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);

        if (isChecked)
        {
            foreach (var cd in danhSachCongDan!)
            {
                if (!HasHosoWithSelectedHang(cd.MaCongDan))
                    selectedCongDans.Add(cd.MaCongDan);
            }
        }
        else
        {
            selectedCongDans.Clear();
        }
    }

    private bool IsAllSelected()
    {
        if (danhSachCongDan == null) return false;

        return danhSachCongDan
            .Where(cd => !HasHosoWithSelectedHang(cd.MaCongDan))
            .All(cd => selectedCongDans.Contains(cd.MaCongDan));
    }

    private void SelectHang(HangGiayPhepDTO hang)
    {
        selectedMaHang = hang.MaHang;

        selectedCongDans.RemoveWhere(id =>
            HasHosoWithSelectedHang(id));
    }

    private bool IsFormValid()
    {
        return selectedCongDans.Any() && !string.IsNullOrEmpty(selectedMaHang);
    }

    private async Task SubmitForm()
    {
        if (!selectedCongDans.Any())
        {
            Layout?.ShowWarning("Vui lòng chọn ít nhất 1 công dân");
            return;
        }

        if (string.IsNullOrEmpty(selectedMaHang))
        {
            Layout?.ShowWarning("Vui lòng chọn hạng GPLX");
            return;
        }

        Layout?.ShowLoading();

        int success = 0;
        int fail = 0;
        var errors = new List<string>();

        try
        {
            foreach (var id in selectedCongDans)
            {
                var model = new CreateHosoDTO
                {
                    MaCongDan = id,
                    MaHang = selectedMaHang!,
                    GhiChu = ghiChu
                };

                try
                {
                    var response = await Http.PostAsJsonAsync("api/Hoso", model);

                    if (response.IsSuccessStatusCode)
                    {
                        success++;
                    }
                    else
                    {
                        fail++;
                        var error = await response.Content.ReadAsStringAsync();
                        errors.Add($"ID {id}: {error}");
                    }
                }
                catch (Exception ex)
                {
                    fail++;
                    errors.Add($"ID {id}: {ex.Message}");
                }
            }

            // ===== THÔNG BÁO =====
            if (success > 0)
            {
                Layout?.ShowSuccess($"Tạo thành công {success} hồ sơ");
            }

            if (fail > 0)
            {
                Layout?.ShowWarning(
                    $"Thất bại {fail} hồ sơ. {string.Join("; ", errors.Take(3))}"
                );
            }
 
            if (success > 0)
            {
                Navigation.NavigateTo("/hoso/them");
            }
        }
        catch (Exception ex)
        {
            Layout?.ShowError($"Lỗi hệ thống: {ex.Message}");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }
}