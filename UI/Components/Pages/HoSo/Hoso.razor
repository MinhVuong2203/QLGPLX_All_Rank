@page "/hoso"
@using UI.Components.Layout
@using UI.DTO.Hoso
@using UI.DTO.Congdan
@using UI.DTO.HangGiayPhep
@inject HttpClient Http
@inject NavigationManager Navigation

<link href="/css/hoso/ds-ho-so.css" rel="stylesheet" />

<div class="page-container">
    <!-- HEADER -->
    <div class="page-header">
        <div class="page-header-left">
            <h1 class="page-title">Quản lý hồ sơ GPLX</h1>
            <p class="page-subtitle">Danh sách tất cả hồ sơ đăng ký thi giấy phép lái xe</p>
        </div>
        <div class="page-header-right">
            <button class="btn-primary" @onclick='() => Navigation.NavigateTo("/hoso/them")'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <line x1="12" y1="5" x2="12" y2="19" stroke-width="2" stroke-linecap="round" />
                    <line x1="5" y1="12" x2="19" y2="12" stroke-width="2" stroke-linecap="round" />
                </svg>
                Tạo hồ sơ mới
            </button>
        </div>
    </div>

    <!-- THỐNG KÊ NHANH -->
    <div class="stats-grid">
        <div class="stat-card stat-total">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" stroke-width="2" />
                    <polyline points="17 21 17 13 7 13 7 21" stroke-width="2" />
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">Tổng hồ sơ</div>
                <div class="stat-value">@(danhSachHoSo?.Count ?? 0)</div>
            </div>
        </div>

        <div class="stat-card stat-processing">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="10" stroke-width="2" />
                    <polyline points="12 6 12 12 16 14" stroke-width="2" stroke-linecap="round" />
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">Đang xử lý</div>
                <div class="stat-value">@GetCountByStatus("Đang xử lý")</div>
            </div>
        </div>

        <div class="stat-card stat-approved">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <polyline points="20 6 9 17 4 12" stroke-width="2" stroke-linecap="round" />
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">Đã duyệt</div>
                <div class="stat-value">@GetCountByStatus("Đã duyệt")</div>
            </div>
        </div>

        <div class="stat-card stat-paid">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="1" y="4" width="22" height="16" rx="2" stroke-width="2" />
                    <line x1="1" y1="10" x2="23" y2="10" stroke-width="2" />
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-label">Đã thanh toán</div>
                <div class="stat-value">@GetCountByPaymentStatus(true)</div>
            </div>
        </div>
    </div>

    <!-- BỘ LỌC -->
    <div class="filter-section">
        <div class="filter-bar">
            <div class="filter-group">
                <label class="filter-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <circle cx="11" cy="11" r="8" stroke-width="2" />
                        <path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    Tìm kiếm
                </label>
                <input type="text"
                       placeholder="Tìm theo tên, CCCD, hạng..."
                       @bind="searchText"
                       @bind:event="oninput"
                       class="filter-input" />
            </div>

            <div class="filter-group">
                <label class="filter-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Trạng thái
                </label>
                <select class="filter-select" @bind="filterStatus">
                    <option value="">Tất cả</option>
                    <option value="Đang xử lý">Đang xử lý</option>
                    <option value="Đã duyệt">Đã duyệt</option>
                    <option value="Từ chối">Từ chối</option>
                    <option value="Hoàn thành">Hoàn thành</option>
                </select>
            </div>

            <div class="filter-group">
                <label class="filter-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2" />
                        <line x1="7" y1="8" x2="17" y2="8" stroke-width="2" />
                    </svg>
                    Hạng GPLX
                </label>
                <select class="filter-select" @bind="filterHang">
                    <option value="">Tất cả</option>
                    @if (danhSachHang != null)
                    {
                        @foreach (var hang in danhSachHang)
                        {
                            <option value="@hang.MaHang">@hang.MaHang - @hang.TenHang</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-group">
                <label class="filter-label">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <rect x="1" y="4" width="22" height="16" rx="2" stroke-width="2" />
                        <line x1="1" y1="10" x2="23" y2="10" stroke-width="2" />
                    </svg>
                    Thanh toán
                </label>
                <select class="filter-select" @bind="filterPayment">
                    <option value="">Tất cả</option>
                    <option value="true">Đã thanh toán</option>
                    <option value="false">Chưa thanh toán</option>
                </select>
            </div>

            @if (HasActiveFilters())
            {
                <button class="btn-reset-filter" @onclick="ResetFilters">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <polyline points="1 4 1 10 7 10" stroke-width="2" stroke-linecap="round" />
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    Xóa bộ lọc
                </button>
            }
        </div>
    </div>

    <!-- DANH SÁCH HỒ SƠ -->
    <div class="table-section">
        @if (danhSachHoSo == null)
        {
            <div class="loading-box">
                <div class="spinner"></div>
                <span>Đang tải danh sách hồ sơ...</span>
            </div>
        }
        else if (!danhSachHoSo.Any())
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" stroke-width="2" />
                    <line x1="9" y1="10" x2="15" y2="10" stroke-width="2" stroke-linecap="round" />
                    <line x1="9" y1="14" x2="15" y2="14" stroke-width="2" stroke-linecap="round" />
                </svg>
                <p>Chưa có hồ sơ nào</p>
                <button class="btn-primary" @onclick='() => Navigation.NavigateTo("/hoso/them")'>
                    Tạo hồ sơ đầu tiên
                </button>
            </div>
        }
        else
        {
            var filteredList = GetFilteredHoSo();

            @if (!filteredList.Any())
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <circle cx="11" cy="11" r="8" stroke-width="2" />
                        <path d="M21 21l-4.35-4.35" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <p>Không tìm thấy hồ sơ phù hợp</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="hoso-table">
                        <thead>
                            <tr>
                                <th class="col-id">Mã HS</th>
                                <th class="col-congdan">Công dân</th>
                                <th class="col-hang">Hạng</th>
                                <th class="col-date">Ngày nộp</th>
                                <th class="col-status">Trạng thái</th>
                                <th class="col-payment">Thanh toán</th>
                                <th class="col-actions">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hs in filteredList)
                            {
                                <tr>
                                    <td class="col-id">
                                        <span class="id-badge">#@hs.HoSoId</span>
                                    </td>
                                    <td class="col-congdan">
                                        <strong>@hs.TenCongDan</strong>
                                    </td>
                                    <td class="col-hang">
                                        <span class="hang-badge">@hs.MaHang</span>
                                    </td>
                                    <td class="col-date">
                                        @hs.NgayNop?.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="col-status">
                                        <span class="status-badge status-@GetStatusClass(hs.TrangThai)">
                                            @hs.TrangThai
                                        </span>
                                    </td>
                                    <td class="col-payment">
                                        @if (hs.TrangThaiThanhToan == true)
                                        {
                                            <span class="payment-badge payment-paid">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                    <polyline points="20 6 9 17 4 12" stroke-width="2" stroke-linecap="round" />
                                                </svg>
                                                Đã thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="payment-badge payment-unpaid">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                    <circle cx="12" cy="12" r="10" stroke-width="2" />
                                                    <line x1="15" y1="9" x2="9" y2="15" stroke-width="2" stroke-linecap="round" />
                                                    <line x1="9" y1="9" x2="15" y2="15" stroke-width="2" stroke-linecap="round" />
                                                </svg>
                                                Chưa thanh toán
                                            </span>
                                        }
                                    </td>
                                    <td class="col-actions">
                                        <div class="action-buttons">
                                            <button class="btn-action btn-view"
                                                    @onclick='() => OpenViewModal(hs)'
                                                    title="Xem chi tiết">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke-width="2" />
                                                    <circle cx="12" cy="12" r="3" stroke-width="2" />
                                                </svg>
                                            </button>
                                            <button class="btn-action btn-edit"
                                                    @onclick='() => OpenEditModal(hs)'
                                                    title="Sửa hồ sơ">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke-width="2" />
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke-width="2" />
                                                </svg>
                                            </button>
                                            <button class="btn-action btn-delete"
                                                    @onclick='() => ConfirmDelete(hs)'
                                                    title="Xóa hồ sơ">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                    <polyline points="3 6 5 6 21 6" stroke-width="2" stroke-linecap="round" />
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke-width="2" />
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

<!-- ==================== MODAL XEM CHI TIẾT ==================== -->
@if (showViewModal && selectedHoSo != null)
{
    <div class="modal-overlay" @onclick="CloseViewModal">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-view">
                <div class="modal-header-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke-width="2" />
                        <circle cx="12" cy="12" r="3" stroke-width="2" />
                    </svg>
                </div>
                <div>
                    <h3>Chi tiết hồ sơ</h3>
                    <span class="modal-subtitle">Mã hồ sơ: #@selectedHoSo.HoSoId</span>
                </div>
                <button class="modal-close" @onclick="CloseViewModal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <line x1="18" y1="6" x2="6" y2="18" stroke-width="2" stroke-linecap="round" />
                        <line x1="6" y1="6" x2="18" y2="18" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <div class="info-grid">
                    <!-- Thông tin công dân -->
                    <div class="info-section">
                        <div class="info-section-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke-width="2" />
                                <circle cx="12" cy="7" r="4" stroke-width="2" />
                            </svg>
                            Thông tin công dân
                        </div>
                        <div class="info-row">
                            <span class="info-label">Họ tên</span>
                            <span class="info-value"><strong>@selectedHoSo.TenCongDan</strong></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">CCCD</span>
                            <span class="info-value">@selectedHoSo.CCCD</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Mã công dân</span>
                            <span class="info-value">@selectedHoSo.MaCongDan</span>
                        </div>
                    </div>

                    <!-- Thông tin hồ sơ -->
                    <div class="info-section">
                        <div class="info-section-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" stroke-width="2" />
                            </svg>
                            Thông tin hồ sơ
                        </div>
                        <div class="info-row">
                            <span class="info-label">Hạng GPLX</span>
                            <span class="info-value">
                                <span class="hang-badge">@selectedHoSo.MaHang</span>
                                @if (!string.IsNullOrEmpty(selectedHoSo.TenHang))
                                {
                                    <span style="margin-left:6px;color:var(--text-secondary)">— @selectedHoSo.TenHang</span>
                                }
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Ngày nộp</span>
                            <span class="info-value">@selectedHoSo.NgayNop?.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Trạng thái</span>
                            <span class="info-value">
                                <span class="status-badge status-@GetStatusClass(selectedHoSo.TrangThai)">
                                    @selectedHoSo.TrangThai
                                </span>
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Thanh toán</span>
                            <span class="info-value">
                                @if (selectedHoSo.TrangThaiThanhToan == true)
                                {
                                    <span class="payment-badge payment-paid">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <polyline points="20 6 9 17 4 12" stroke-width="2" stroke-linecap="round" />
                                        </svg>
                                        Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="payment-badge payment-unpaid">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                            <circle cx="12" cy="12" r="10" stroke-width="2" />
                                            <line x1="15" y1="9" x2="9" y2="15" stroke-width="2" stroke-linecap="round" />
                                            <line x1="9" y1="9" x2="15" y2="15" stroke-width="2" stroke-linecap="round" />
                                        </svg>
                                        Chưa thanh toán
                                    </span>
                                }
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(selectedHoSo.GhiChu))
                        {
                            <div class="info-row">
                                <span class="info-label">Ghi chú</span>
                                <span class="info-value">@selectedHoSo.GhiChu</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseViewModal">Đóng</button>
                <button class="btn-primary" @onclick="ChuyenSangEdit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:16px;height:16px">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke-width="2" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke-width="2" />
                    </svg>
                    Chỉnh sửa
                </button>
            </div>
        </div>
    </div>
}

<!-- ==================== MODAL CHỈNH SỬA ==================== -->
@if (showEditModal && selectedHoSo != null)
{
    <div class="modal-overlay" @onclick="CloseEditModal">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-edit">
                <div class="modal-header-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke-width="2" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke-width="2" />
                    </svg>
                </div>
                <div>
                    <h3>Chỉnh sửa hồ sơ</h3>
                    <span class="modal-subtitle">@selectedHoSo.TenCongDan — #@selectedHoSo.HoSoId</span>
                </div>
                <button class="modal-close" @onclick="CloseEditModal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <line x1="18" y1="6" x2="6" y2="18" stroke-width="2" stroke-linecap="round" />
                        <line x1="6" y1="6" x2="18" y2="18" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <!-- Thông tin chỉ đọc -->
                <div class="edit-readonly-section">
                    <div class="edit-readonly-item">
                        <span class="info-label">Họ tên</span>
                        <span class="info-value"><strong>@selectedHoSo.TenCongDan</strong></span>
                    </div>
                    <div class="edit-readonly-item">
                        <span class="info-label">CCCD</span>
                        <span class="info-value">@selectedHoSo.CCCD</span>
                    </div>
                    <div class="edit-readonly-item">
                        <span class="info-label">Ngày nộp</span>
                        <span class="info-value">@selectedHoSo.NgayNop?.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- Form chỉnh sửa -->
                <div class="edit-form">
                    <!-- Hạng GPLX -->
                    <div class="form-group">
                        <label class="form-label">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2" />
                                <line x1="7" y1="8" x2="17" y2="8" stroke-width="2" />
                            </svg>
                            Hạng GPLX <span class="required">*</span>
                        </label>
                        <select class="filter-select form-select" @bind="editMaHang">
                            <option value="">-- Chọn hạng --</option>
                            @if (danhSachHang != null)
                            {
                                @foreach (var hang in danhSachHang)
                                {
                                    <option value="@hang.MaHang">@hang.MaHang - @hang.TenHang</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Ghi chú -->
                    <div class="form-group">
                        <label class="form-label">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-width="2" />
                                <polyline points="14 2 14 8 20 8" stroke-width="2" />
                                <line x1="16" y1="13" x2="8" y2="13" stroke-width="2" />
                                <line x1="16" y1="17" x2="8" y2="17" stroke-width="2" />
                            </svg>
                            Ghi chú
                        </label>
                        <textarea class="filter-input form-textarea"
                                  rows="3"
                                  placeholder="Nhập ghi chú (nếu có)..."
                                  @bind="editGhiChu"></textarea>
                    </div>

                    <!-- Trạng thái thanh toán -->
                    <div class="form-group">
                        <label class="form-label">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <rect x="1" y="4" width="22" height="16" rx="2" stroke-width="2" />
                                <line x1="1" y1="10" x2="23" y2="10" stroke-width="2" />
                            </svg>
                            Trạng thái thanh toán
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   class="checkbox-input"
                                   @bind="editTrangThaiThanhToan" />
                            <span class="checkbox-custom"></span>
                            <span>Đã thanh toán</span>
                        </label>
                    </div>

                    <!-- Trạng thái hồ sơ hiện tại -->
                    <div class="form-group">
                        <label class="form-label">Trạng thái hồ sơ hiện tại</label>
                        <div>
                            <span class="status-badge status-@GetStatusClass(selectedHoSo.TrangThai)">
                                @selectedHoSo.TrangThai
                            </span>
                            <small style="display:block;margin-top:6px;color:var(--text-muted)">
                                Dùng nút "Duyệt" hoặc "Từ chối" bên dưới để thay đổi trạng thái.
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer modal-footer-edit">
                <button class="btn-secondary" @onclick="CloseEditModal">Hủy</button>
                <div class="modal-footer-actions">
                    <button class="btn-danger-outline" @onclick="TuChoiHoSo" title="Đổi trạng thái thành Từ chối">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:16px;height:16px">
                            <circle cx="12" cy="12" r="10" stroke-width="2" />
                            <line x1="15" y1="9" x2="9" y2="15" stroke-width="2" stroke-linecap="round" />
                            <line x1="9" y1="9" x2="15" y2="15" stroke-width="2" stroke-linecap="round" />
                        </svg>
                        Từ chối
                    </button>
                    <button class="btn-success" @onclick="DuyetHoSo" title="Đổi trạng thái thành Đã duyệt">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:16px;height:16px">
                            <polyline points="20 6 9 17 4 12" stroke-width="2" stroke-linecap="round" />
                        </svg>
                        Duyệt
                    </button>
                    <button class="btn-primary" @onclick="SaveEdit" title="Lưu hạng và ghi chú">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:16px;height:16px">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" stroke-width="2" />
                            <polyline points="17 21 17 13 7 13 7 21" stroke-width="2" />
                        </svg>
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ==================== MODAL XÁC NHẬN XÓA ==================== -->
@if (showDeleteModal && selectedHoSo != null)
{
    <div class="modal-overlay" @onclick="CloseDeleteModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Xác nhận xóa hồ sơ</h3>
                <button class="modal-close" @onclick="CloseDeleteModal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <line x1="18" y1="6" x2="6" y2="18" stroke-width="2" stroke-linecap="round" />
                        <line x1="6" y1="6" x2="18" y2="18" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="modal-icon-warning">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M12 2L2 20h20L12 2z" stroke-width="2" stroke-linejoin="round" />
                        <line x1="12" y1="9" x2="12" y2="13" stroke-width="2" stroke-linecap="round" />
                        <circle cx="12" cy="17" r="1" fill="currentColor" />
                    </svg>
                </div>
                <p class="modal-message">
                    Bạn có chắc chắn muốn xóa hồ sơ của <strong>@selectedHoSo.TenCongDan</strong> (Hạng @selectedHoSo.MaHang)?
                </p>
                <p class="modal-warning">Hành động này không thể hoàn tác!</p>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CloseDeleteModal">Hủy bỏ</button>
                <button class="btn-danger" @onclick="DeleteHoSo">Xóa hồ sơ</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }

    private List<HosoDTO>? danhSachHoSo;
    private List<HangGiayPhepDTO>? danhSachHang;

    // Bộ lọc
    private string searchText = "";
    private string filterStatus = "";
    private string filterHang = "";
    private string filterPayment = "";

    // Trạng thái modal
    private bool showViewModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;

    // Hồ sơ đang được chọn (dùng chung cho xem/sửa/xóa)
    private HosoDTO? selectedHoSo;

    // Giá trị form chỉnh sửa
    private string editMaHang = "";
    private string editGhiChu = "";
    private bool editTrangThaiThanhToan = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        Layout?.ShowLoading();
        try
        {
            var hosoTask = Http.GetFromJsonAsync<List<HosoDTO>>("https://localhost:7033/api/Hoso");
            var hangTask = Http.GetFromJsonAsync<List<HangGiayPhepDTO>>("https://localhost:7033/api/HangGiayPhep");

            await Task.WhenAll(hosoTask, hangTask);

            danhSachHoSo = await hosoTask;
            danhSachHang = await hangTask;
        }
        catch (Exception ex)
        {
            Layout?.ShowError($"Lỗi khi tải dữ liệu: {ex.Message}");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }

    // ─────────────── MODAL XEM ───────────────
    private void OpenViewModal(HosoDTO hoso)
    {
        selectedHoSo = hoso;
        showViewModal = true;
        StateHasChanged();
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        selectedHoSo = null;
        StateHasChanged();
    }

    // Nút "Chỉnh sửa" trong modal Xem → chuyển thẳng sang modal Sửa
    private void ChuyenSangEdit()
    {
        if (selectedHoSo == null) return;
        var hs = selectedHoSo;
        showViewModal = false;
        // Mở modal sửa với dữ liệu hiện tại
        editMaHang = hs.MaHang;
        editGhiChu = hs.GhiChu ?? "";
        editTrangThaiThanhToan = hs.TrangThaiThanhToan ?? false;
        showEditModal = true;
        StateHasChanged();
    }

    // ─────────────── MODAL SỬA ───────────────
    private void OpenEditModal(HosoDTO hoso)
    {
        selectedHoSo = hoso;
        editMaHang = hoso.MaHang;
        editGhiChu = hoso.GhiChu ?? "";
        editTrangThaiThanhToan = hoso.TrangThaiThanhToan ?? false;
        showEditModal = true;
        StateHasChanged();
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        selectedHoSo = null;
        StateHasChanged();
    }

    // Nút OK — chỉ lưu hạng, ghi chú, thanh toán; KHÔNG đổi TrangThai
    private async Task SaveEdit()
    {
        if (selectedHoSo == null) return;
        if (string.IsNullOrWhiteSpace(editMaHang))
        {
            Layout?.ShowWarning("Vui lòng chọn hạng GPLX!");
            return;
        }

        await CallUpdateApi(selectedHoSo.TrangThai ?? "Đang xử lý", "Cập nhật hồ sơ thành công!");
    }

    // Nút Duyệt — lưu tất cả + đổi TrangThai = "Đã duyệt"
    private async Task DuyetHoSo()
    {
        if (selectedHoSo == null) return;
        await CallUpdateApi("Đã duyệt", "Duyệt hồ sơ thành công!");
    }

    // Nút Từ chối — lưu tất cả + đổi TrangThai = "Từ chối"
    private async Task TuChoiHoSo()
    {
        if (selectedHoSo == null) return;
        await CallUpdateApi("Từ chối", "Đã từ chối hồ sơ.");
    }

    // Hàm dùng chung để gọi API cập nhật
    private async Task CallUpdateApi(string trangThai, string successMsg)
    {
        if (selectedHoSo == null) return;

        Layout?.ShowLoading();
        try
        {
            var dto = new UpdateHosoDTO
            {               
                MaHang = editMaHang,
                GhiChu = editGhiChu,
                TrangThaiThanhToan = editTrangThaiThanhToan,
                TrangThai = trangThai
            };

            var response = await Http.PutAsJsonAsync(
                $"https://localhost:7033/api/Hoso/{selectedHoSo.HoSoId}", dto);

            if (response.IsSuccessStatusCode)
            {
                Layout?.ShowSuccess(successMsg);
                CloseEditModal();
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Layout?.ShowError($"Thất bại: {error}");
            }
        }
        catch (Exception ex)
        {
            Layout?.ShowError($"Lỗi: {ex.Message}");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }

    // ─────────────── MODAL XÓA ───────────────
    private void ConfirmDelete(HosoDTO hoso)
    {
        selectedHoSo = hoso;
        showDeleteModal = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        selectedHoSo = null;
        StateHasChanged();
    }

    private async Task DeleteHoSo()
    {
        if (selectedHoSo == null) return;

        Layout?.ShowLoading();
        try
        {
            var response = await Http.DeleteAsync(
                $"https://localhost:7033/api/Hoso/{selectedHoSo.HoSoId}");

            if (response.IsSuccessStatusCode)
            {
                Layout?.ShowSuccess("Xóa hồ sơ thành công!");
                CloseDeleteModal();
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Layout?.ShowError($"Xóa hồ sơ thất bại: {error}");
            }
        }
        catch (Exception ex)
        {
            Layout?.ShowError($"Lỗi khi xóa hồ sơ: {ex.Message}");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }

    // ─────────────── CÁC HÀM TIỆN ÍCH ───────────────
    private IEnumerable<HosoDTO> GetFilteredHoSo()
    {
        if (danhSachHoSo == null) return Enumerable.Empty<HosoDTO>();

        var filtered = danhSachHoSo.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.ToLower();
            filtered = filtered.Where(h =>
                h.TenCongDan?.ToLower().Contains(search) == true ||
                h.CCCD?.Contains(search) == true ||
                h.MaHang.ToLower().Contains(search) ||
                h.TenHang?.ToLower().Contains(search) == true
            );
        }

        if (!string.IsNullOrWhiteSpace(filterStatus))
            filtered = filtered.Where(h => h.TrangThai == filterStatus);

        if (!string.IsNullOrWhiteSpace(filterHang))
            filtered = filtered.Where(h => h.MaHang == filterHang);

        if (!string.IsNullOrWhiteSpace(filterPayment))
        {
            var isPaid = filterPayment == "true";
            filtered = filtered.Where(h => h.TrangThaiThanhToan == isPaid);
        }

        return filtered.OrderByDescending(h => h.NgayNop);
    }

    private int GetCountByStatus(string status) =>
        danhSachHoSo?.Count(h => h.TrangThai == status) ?? 0;

    private int GetCountByPaymentStatus(bool isPaid) =>
        danhSachHoSo?.Count(h => h.TrangThaiThanhToan == isPaid) ?? 0;

    private string GetStatusClass(string? status) => status?.ToLower() switch
    {
        "đang xử lý" => "processing",
        "đã duyệt" => "approved",
        "từ chối" => "rejected",
        "hoàn thành" => "completed",
        _ => "default"
    };

    private bool HasActiveFilters() =>
        !string.IsNullOrWhiteSpace(searchText) ||
        !string.IsNullOrWhiteSpace(filterStatus) ||
        !string.IsNullOrWhiteSpace(filterHang) ||
        !string.IsNullOrWhiteSpace(filterPayment);

    private void ResetFilters()
    {
        searchText = "";
        filterStatus = "";
        filterHang = "";
        filterPayment = "";
        StateHasChanged();
    }
}
