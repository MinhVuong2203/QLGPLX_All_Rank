@page "/ky-thi/{KyThiId:int}/them-ho-so"
@using UI.DTO.KyThi
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<link href="/css/kythi/them-ho-so-vao-ky-thi.css" rel="stylesheet" />

<PageTitle>Thêm thí sinh vào kỳ thi - GPLX</PageTitle>

<div class="them-ho-so-container">
    <!-- HEADER -->
    <div class="page-header-compact">
        <button class="btn-back" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </button>
        <div class="header-content">
            <div class="header-title">
                <i class="bi bi-person-plus-fill"></i>
                <div>
                    <h1>Thêm thí sinh vào kỳ thi</h1>
                    <p class="subtitle">@kyThiInfo?.TenKyThi</p>
                </div>
            </div>
            <div class="header-info">
                <span class="info-badge">
                    <i class="bi bi-mortarboard"></i>
                    @kyThiInfo?.TenHang
                </span>
                <span class="info-badge">
                    <i class="bi bi-people"></i>
                    @kyThiInfo?.SoLuongDangKy / @kyThiInfo?.SoLuongToiDa
                </span>
            </div>
        </div>
    </div>

    <div class="content-wrapper">
        <!-- CỘT TRÁI: DANH SÁCH HỒ SƠ ĐÃ DUYỆT -->
        <div class="left-panel">
            <div class="panel-header">
                <h3>
                    <i class="bi bi-file-earmark-check"></i>
                    Hồ sơ đã duyệt
                    <span class="count-badge">@(hoSoDaDuyet?.Count ?? 0)</span>
                </h3>
            </div>

            <!-- FILTER & SEARCH -->
            <div class="filter-section">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Tìm theo tên, CCCD..." 
                           @bind="searchText" @bind:event="oninput"/>
                </div>
                
                <div class="date-filter">
                    <input type="date" @bind="fromDate" />
                    <span>→</span>
                    <input type="date" @bind="toDate" />
                </div>
            </div>

            <!-- DANH SÁCH -->
            @if (hoSoDaDuyet == null)
            {
                <div class="loading-placeholder">
                    <div class="spinner-border text-primary"></div>
                    <p>Đang tải danh sách...</p>
                </div>
            }
            else if (!GetFilteredHoSo().Any())
            {
                <div class="empty-state-small">
                    <i class="bi bi-inbox"></i>
                    <p>Không tìm thấy hồ sơ nào</p>
                </div>
            }
            else
            {
                <div class="ho-so-list">
                    @foreach (var hs in GetPagedHoSo())
                    {
                        <div class="ho-so-item @(selectedHoSo.Contains(hs.HoSoID) ? "selected" : "") 
                                               @(hs.DaDangKyKyThi ? "disabled" : "")"
                             @onclick="() => ToggleSelection(hs)">
                            <div class="ho-so-checkbox">
                                @if (hs.DaDangKyKyThi)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else if (selectedHoSo.Contains(hs.HoSoID))
                                {
                                    <i class="bi bi-check-square-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-square"></i>
                                }
                            </div>
                            <div class="ho-so-info">
                                <div class="ho-so-name">@hs.HoTenCongDan</div>
                                <div class="ho-so-details">
                                    <span><i class="bi bi-credit-card"></i> @hs.CCCD</span>
                                    <span><i class="bi bi-calendar3"></i> @hs.NgayNop.ToString("dd/MM/yyyy")</span>
                                </div>
                                @if (hs.DaDangKyKyThi)
                                {
                                    <div class="badge-registered">Đã đăng ký</div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="pagination">
                    <button @onclick="PrevPage" disabled="@(currentPage == 1)"><i class="bi bi-caret-left"></i></button>
                    <span>Trang @currentPage</span>
                    <button @onclick="NextPage"><i class="bi bi-caret-right"></i></button>
                </div>
            }
        </div>

        <!-- CỘT PHẢI: HỒ SƠ ĐÃ CHỌN -->
        <div class="right-panel">
            <!-- HỒ SƠ ĐÃ CHỌN -->
            <div class="selected-section">
                <div class="panel-header">
                    <h3>
                        <i class="bi bi-check-circle"></i>
                        Đã chọn
                        <span class="count-badge primary">@selectedHoSo.Count</span>
                    </h3>
                    @if (selectedHoSo.Any())
                    {
                        <button class="btn-clear-all" @onclick="ClearSelection">
                            <i class="bi bi-x-circle"></i>
                            Bỏ chọn tất cả
                        </button>
                    }
                </div>

                @if (!selectedHoSo.Any())
                {
                    <div class="empty-state-small">
                        <i class="bi bi-hand-index"></i>
                        <p>Chưa chọn hồ sơ nào</p>
                        <small>Nhấp vào hồ sơ bên trái để chọn</small>
                    </div>
                }
                else
                {
                    <div class="selected-list">
                        @foreach (var id in selectedHoSo)
                        {
                            var hs = hoSoDaDuyet?.FirstOrDefault(h => h.HoSoID == id);
                            if (hs != null)
                            {
                                <div class="selected-item">
                                    <div class="item-info">
                                        <div class="item-name">@hs.HoTenCongDan</div>
                                        <div class="item-detail">@hs.CCCD</div>
                                    </div>
                                    <button class="btn-remove" @onclick="() => RemoveFromSelection(id)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                        }
                    </div>

                    <div class="action-section">
                        <button class="btn-add-all" @onclick="HandleAddHoSo" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Đang thêm...</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle"></i>
                                <span>Thêm @selectedHoSo.Count hồ sơ vào kỳ thi</span>
                            }
                        </button>
                    </div>
                }
            </div>

            
        </div>
    </div>
    <!-- HỒ SƠ TRONG KỲ THI -->
    <div class="registered-section">
        <div class="panel-header">
            <h3>
                <i class="bi bi-people-fill"></i>
                Thí sinh đã đăng ký
                <span class="count-badge success">@(hoSoTrongKyThi?.Count ?? 0)</span>
            </h3>
        </div>

        @if (hoSoTrongKyThi == null)
        {
            <div class="loading-placeholder">
                <div class="spinner-border spinner-border-sm text-success"></div>
            </div>
        }
        else if (!hoSoTrongKyThi.Any())
        {
            <div class="empty-state-small">
                <i class="bi bi-person-x"></i>
                <p>Chưa có thí sinh nào</p>
            </div>
        }
        else
        {
            <div class="registered-list">
                @foreach (var hs in GetPagedRegistered())
                {
                    <div class="registered-item">
                        <div class="item-info">
                            <div class="item-name">@hs.HoTenCongDan</div>
                            <div class="item-detail">@hs.CCCD</div>
                        </div>
                        <button class="btn-remove-small" @onclick="() => HandleRemoveHoSo(hs.HoSoID)"
                                title="Xóa khỏi kỳ thi">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
            </div>
            <div class="pagination">
                <button @onclick="PrevPageRegistered" disabled="@(currentPageRegistered == 1)"><i class="bi bi-caret-left"></i>

            </button>
                <span>Trang @currentPageRegistered</span>
                <button @onclick="NextPageRegistered"><i class="bi bi-caret-right"></i></button>
            </div>
        }
    </div>
</div>

@code {

    [Parameter] public int KyThiId { get; set; }
    [CascadingParameter] public UI.Components.Layout.MainLayout? Layout { get; set; }

    private KyThiDTO? kyThiInfo;
    private List<HoSoDaDuyetDTO>? hoSoDaDuyet;
    private List<HoSoDaDuyetDTO>? hoSoTrongKyThi;
    private HashSet<int> selectedHoSo = new();
    private string _searchText = "";
    private string searchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            currentPage = 1; // reset page
        }
    }
    private bool isSubmitting = false;

    private DateTime? fromDate;
    private DateTime? toDate;

    private int currentPage = 1;
    private int pageSize = 5;

    private int currentPageRegistered = 1;
    private int pageSizeRegistered = 5;

    protected override async Task OnInitializedAsync()
    {
        await LoadKyThiInfo();
        await LoadHoSoDaDuyet();
        await LoadHoSoTrongKyThi();
    }

    private async Task LoadKyThiInfo()
    {
        try
        {
            kyThiInfo = await Http.GetFromJsonAsync<KyThiDTO>($"api/KyThi/{KyThiId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi: {ex.Message}");
            Layout?.ShowError("Không thể tải thông tin kỳ thi");
        }
    }

    private async Task LoadHoSoDaDuyet()
    {
        try
        {
            Layout?.ShowLoading();
            var maHang = kyThiInfo?.MaHang ?? "";
            hoSoDaDuyet = await Http.GetFromJsonAsync<List<HoSoDaDuyetDTO>>($"api/KyThi/hoso-da-duyet?maHang={maHang}");

            // Đánh dấu các hồ sơ đã đăng ký kỳ thi
            if (hoSoTrongKyThi != null)
            {
                var idsInKyThi = hoSoTrongKyThi.Select(h => h.HoSoID).ToHashSet();
                foreach (var hs in hoSoDaDuyet ?? new())
                {
                    hs.DaDangKyKyThi = idsInKyThi.Contains(hs.HoSoID);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi: {ex.Message}");
            Layout?.ShowError("Không thể tải danh sách hồ sơ");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }

    private async Task LoadHoSoTrongKyThi()
    {
        try
        {
            hoSoTrongKyThi = await Http.GetFromJsonAsync<List<HoSoDaDuyetDTO>>($"api/KyThi/{KyThiId}/hoso");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi: {ex.Message}");
        }
    }

    private List<HoSoDaDuyetDTO> GetFilteredHoSo()
    {
        if (hoSoDaDuyet == null) return new();

        var idsInKyThi = hoSoTrongKyThi?
            .Select(x => x.HoSoID)
            .ToHashSet() ?? new();

        return hoSoDaDuyet.Where(h =>
            !idsInKyThi.Contains(h.HoSoID) &&

            (string.IsNullOrEmpty(searchText) ||
                (h.HoTenCongDan?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (h.CCCD?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            &&
            (!fromDate.HasValue || h.NgayNop.Date >= fromDate.Value.Date)
            &&
            (!toDate.HasValue || h.NgayNop.Date <= toDate.Value.Date)
        ).ToList();
    }

    private void ToggleSelection(HoSoDaDuyetDTO hoSo)
    {
        if (hoSo.DaDangKyKyThi) return; // Không cho chọn nếu đã đăng ký

        if (selectedHoSo.Contains(hoSo.HoSoID))
            selectedHoSo.Remove(hoSo.HoSoID);
        else
            selectedHoSo.Add(hoSo.HoSoID);
    }

    private void RemoveFromSelection(int id)
    {
        selectedHoSo.Remove(id);
    }

    private void ClearSelection()
    {
        selectedHoSo.Clear();
    }

    private async Task HandleAddHoSo()
    {
        if (!selectedHoSo.Any())
        {
            Layout?.ShowWarning("Vui lòng chọn ít nhất một hồ sơ");
            return;
        }

        try
        {
            isSubmitting = true;
            Layout?.ShowLoading();

            var dto = new ThemHoSoVaoKyThiDTO
            {
                KyThiID = KyThiId,
                DanhSachHoSoID = selectedHoSo.ToList()
            };

            var response = await Http.PostAsJsonAsync("api/KyThi/them-hoso", dto);

            if (response.IsSuccessStatusCode)
            {
                Layout?.ShowSuccess($"Đã thêm {selectedHoSo.Count} hồ sơ vào kỳ thi");
                selectedHoSo.Clear();

                await LoadKyThiInfo();
                await LoadHoSoTrongKyThi();
                await LoadHoSoDaDuyet();
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<dynamic>();
                Layout?.ShowError(errorObj?.message ?? "Có lỗi xảy ra");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi: {ex.Message}");
            Layout?.ShowError("Đã xảy ra lỗi khi thêm hồ sơ");
        }
        finally
        {
            isSubmitting = false;
            Layout?.HideLoading();
        }
    }

    private async Task HandleRemoveHoSo(int hoSoId)
    {
        try
        {
            Layout?.ShowLoading();

            var response = await Http.DeleteAsync($"api/KyThi/{KyThiId}/hoso/{hoSoId}");

            if (response.IsSuccessStatusCode)
            {
                Layout?.ShowSuccess("Đã xóa hồ sơ khỏi kỳ thi");
                await LoadKyThiInfo();
                await LoadHoSoTrongKyThi();
                await LoadHoSoDaDuyet();
            }
            else
            {
                Layout?.ShowError("Không thể xóa hồ sơ");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi: {ex.Message}");
            Layout?.ShowError("Đã xảy ra lỗi khi xóa hồ sơ");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }

    // Khu vực phân trang Danh sách Hồ sơ
    private List<HoSoDaDuyetDTO> GetPagedHoSo()
    {
        return GetFilteredHoSo()
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void NextPage()
    {
        if (currentPage * pageSize < GetFilteredHoSo().Count)
            currentPage++;
    }

    private void PrevPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    // Khu vực phân trang Thí sinh đã đăng ký
    private List<HoSoDaDuyetDTO> GetPagedRegistered()
    {
        if (hoSoTrongKyThi == null) return new();

        return hoSoTrongKyThi
            .Skip((currentPageRegistered - 1) * pageSizeRegistered)
            .Take(pageSizeRegistered)
            .ToList();
    }

    private void NextPageRegistered()
    {
        if (hoSoTrongKyThi != null &&
            currentPageRegistered * pageSizeRegistered < hoSoTrongKyThi.Count)
            currentPageRegistered++;
    }

    private void PrevPageRegistered()
    {
        if (currentPageRegistered > 1)
            currentPageRegistered--;
    }
    
    // Khu vực back
    private void GoBack() => Navigation.NavigateTo("/ky-thi");
}
