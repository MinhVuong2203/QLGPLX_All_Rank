@page "/ky-thi"
@using UI.Components.Layout
@using UI.DTO.HangGiayPhep
@using UI.DTO.KyThi
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<link href="/css/kythi/kythi-css.css" rel="stylesheet" />

<PageTitle>Quản lý Kỳ thi - GPLX</PageTitle>

<div class="ky-thi-container">
    <div class="page-header">
        <div class="header-content">
            <div class="title-section">
                <i class="bi bi-calendar-event-fill"></i>
                <div>
                    <h1>Quản lý Kỳ thi</h1>
                    <p class="subtitle">Tổ chức và quản lý các kỳ sát hạch GPLX</p>
                </div>
            </div>
            <button class="btn-primary" @onclick="NavigateToCreate">
                <i class="bi bi-plus-circle"></i>
                Tạo kỳ thi mới
            </button>
        </div>
    </div>

    @if (danhSachKyThi == null || !danhSachKyThi.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h3>Chưa có kỳ thi nào</h3>
            <p>Hãy tạo kỳ thi đầu tiên để bắt đầu tổ chức sát hạch</p>
            <button class="btn-primary" @onclick="NavigateToCreate">
                <i class="bi bi-plus-circle"></i>
                Tạo kỳ thi mới
            </button>
        </div>
    }
    else
    {
        <div class="filter-section">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Tìm kiếm kỳ thi..." @bind="searchText" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <select @bind="filterTrangThai" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Sắp diễn ra">Sắp diễn ra</option>
                    <option value="Đang diễn ra">Đang diễn ra</option>
                    <option value="Đã kết thúc">Đã kết thúc</option>
                </select>
                <select @bind="filterMaHang" class="form-select">
                    <option value="">Tất cả hạng</option>

                    @if (danhSachHang != null)
                    {
                        @foreach (var hang in danhSachHang)
                        {
                            <option value="@hang.MaHang">
                                @hang.MaHang - @hang.TenHang
                            </option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="stats-cards">
            <div class="stat-card">
                <div class="stat-icon upcoming">
                    <i class="bi bi-calendar-plus"></i>
                </div>
                <div class="stat-info">
                    <h4>@danhSachKyThi.Count(k => k.TrangThai == "Sắp diễn ra")</h4>
                    <p>Sắp diễn ra</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon ongoing">
                    <i class="bi bi-play-circle"></i>
                </div>
                <div class="stat-info">
                    <h4>@danhSachKyThi.Count(k => k.TrangThai == "Đang diễn ra")</h4>
                    <p>Đang diễn ra</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon completed">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-info">
                    <h4>@danhSachKyThi.Count(k => k.TrangThai == "Đã kết thúc")</h4>
                    <p>Đã kết thúc</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon total">
                    <i class="bi bi-people"></i>
                </div>
                <div class="stat-info">
                    <h4>@danhSachKyThi.Sum(k => k.SoLuongDangKy)</h4>
                    <p>Thí sinh đã đăng ký</p>
                </div>
            </div>
        </div>

        <div class="ky-thi-grid">
            @foreach (var kyThi in GetFilteredKyThi())
            {
                <div class="ky-thi-card @GetStatusClass(kyThi.TrangThai)">
                    <div class="card-header">
                        <div class="header-top">
                            <span class="badge-hang">@kyThi.MaHang - @kyThi.TenHang</span>
                            <span class="badge-status @GetStatusClass(kyThi.TrangThai)">
                                @kyThi.TrangThai
                            </span>
                        </div>
                        <h3 class="card-title">@kyThi.TenKyThi</h3>
                    </div>

                    <div class="card-body">
                        <div class="info-row">
                            <i class="bi bi-calendar3"></i>
                            <div class="info-content">
                                <span class="label">Thời gian</span>
                                <span class="value">
                                    @(kyThi.NgayBatDau?.ToString("dd/MM/yyyy") ?? "N/A") -
                                    @(kyThi.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "N/A")
                                </span>
                            </div>
                        </div>
                        <div class="info-row">
                            <i class="bi bi-geo-alt"></i>
                            <div class="info-content">
                                <span class="label">Địa điểm</span>
                                <span class="value">@kyThi.DiaDiem</span>
                            </div>
                        </div>
                        <div class="info-row">
                            <i class="bi bi-people"></i>
                            <div class="info-content">
                                <span class="label">Thí sinh</span>
                                <span class="value">@kyThi.SoLuongDangKy / @kyThi.SoLuongToiDa</span>
                            </div>
                        </div>

                        <div class="progress-section">
                            <div class="progress-info">
                                <span>Tỷ lệ đăng ký</span>
                                <span class="percentage">@GetPercentage(kyThi.SoLuongDangKy, kyThi.SoLuongToiDa)%</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @GetPercentage(kyThi.SoLuongDangKy, kyThi.SoLuongToiDa)%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <button class="btn-action" @onclick="() => NavigateToDetail(kyThi.KyThiID)">
                            <i class="bi bi-eye"></i>
                            Chi tiết
                        </button>
                        <button class="btn-action" @onclick="() => NavigateToAddHoSo(kyThi.KyThiID)">
                            <i class="bi bi-person-plus"></i>
                            Thêm thí sinh
                        </button>
                        <button class="btn-action" @onclick="() => NavigateToEdit(kyThi.KyThiID)">
                            <i class="bi bi-pencil"></i>
                            Sửa
                        </button>
                        <button class="btn-action delete" @onclick="() => DeleteKyThi(kyThi.KyThiID)">
                            <i class="bi bi-trash"></i>
                            Xóa
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<KyThiDTO>? danhSachKyThi;
    private bool isLoading = true;
    private string searchText = "";
    private string filterTrangThai = "";
    private string filterMaHang = "";
    private List<HangGiayPhepDTO>? danhSachHang;
    [CascadingParameter] public MainLayout? Layout { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadHang();
        await LoadData();
    }

    private async Task LoadHang()
    {
        try
        {
            Layout?.ShowLoading();
            danhSachHang = await Http.GetFromJsonAsync<List<HangGiayPhepDTO>>("api/HangGiayPhep");
        }
        catch
        {
            Layout?.ShowError("Không tải được danh sách hạng GPLX");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }

    private async Task LoadData()
    {
        try
        {
            Layout?.ShowLoading();

            danhSachKyThi = await Http.GetFromJsonAsync<List<KyThiDTO>>("api/KyThi");

            if (danhSachKyThi == null || !danhSachKyThi.Any())
            {
                Layout?.ShowInfo("Chưa có kỳ thi nào");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Layout?.ShowError("Không thể tải danh sách kỳ thi!");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }

    private List<KyThiDTO> GetFilteredKyThi()
    {
        if (danhSachKyThi == null) return new List<KyThiDTO>();

        return danhSachKyThi.Where(k =>
            (string.IsNullOrEmpty(searchText) || k.TenKyThi.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterTrangThai) || k.TrangThai == filterTrangThai) &&
            (string.IsNullOrEmpty(filterMaHang) || k.MaHang == filterMaHang)
        ).ToList();
    }

    private string GetStatusClass(string trangThai)
    {
        return trangThai switch
        {
            "Sắp diễn ra" => "upcoming",
            "Đang diễn ra" => "ongoing",
            "Đã kết thúc" => "completed",
            _ => ""
        };
    }

    private int GetPercentage(int current, int max)
    {
        if (max == 0) return 0;
        return (int)((double)current / max * 100);
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/ky-thi/them");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/ky-thi/sua/{id}");
    private void NavigateToDetail(int id) => Navigation.NavigateTo($"/ky-thi/chi-tiet/{id}");
    private void NavigateToAddHoSo(int id) => Navigation.NavigateTo($"/ky-thi/{id}/them-ho-so");

    private async Task DeleteKyThi(int id)
    {
        // có thể thay bằng modal sau nếu bạn muốn
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc muốn xóa?");
        if (!confirmed) return;

        try
        {
            Layout?.ShowLoading();

            var response = await Http.DeleteAsync($"api/KyThi/{id}");

            if (response.IsSuccessStatusCode)
            {
                Layout?.ShowSuccess("Xóa kỳ thi thành công!");
                await LoadData();
            }
            else
            {
                Layout?.ShowError("Không thể xóa kỳ thi!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Layout?.ShowError("Đã xảy ra lỗi khi xóa!");
        }
        finally
        {
            Layout?.HideLoading();
        }
    }
}
