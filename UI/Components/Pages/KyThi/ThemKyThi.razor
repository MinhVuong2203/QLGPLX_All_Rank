@page "/ky-thi/them"
@using UI.Components.Layout
@using UI.DTO.KyThi
@using UI.DTO.HangGiayPhep
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<link href="/css/kythi/them-ho-so.css" rel="stylesheet" /> 
<PageTitle>Tạo kỳ thi mới - GPLX</PageTitle>

<div class="them-ky-thi-container">
    <div class="page-header-compact">
        <button class="btn-back" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </button>
        <div class="header-title">
            <i class="bi bi-calendar-plus"></i>
            <h1>Tạo kỳ thi mới</h1>
        </div>
    </div>

    <div class="form-container">
        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="form-section">
                <h3 class="section-title">
                    <i class="bi bi-info-circle"></i>
                    Thông tin cơ bản
                </h3>

                <div class="form-grid">
                    <div class="form-group full-width">
                        <label>Tên kỳ thi <span class="required">*</span></label>
                        <InputText @bind-Value="model.TenKyThi" class="form-control" placeholder="VD: Kỳ thi sát hạch GPLX Tháng 5/2024" />
                        <ValidationMessage For="@(() => model.TenKyThi)" />
                    </div>

                    <div class="form-group">
                        <label>Hạng giấy phép <span class="required">*</span></label>
                        <InputSelect @bind-Value="model.MaHang" class="form-control">
                            <option value="">-- Chọn hạng --</option>
                            @if (danhSachHang != null)
                            {
                                @foreach (var hang in danhSachHang)
                                {
                                    <option value="@hang.MaHang">@hang.MaHang - @hang.TenHang</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => model.MaHang)" />
                    </div>

                </div>
            </div>

            <div class="form-section">
                <h3 class="section-title">
                    <i class="bi bi-calendar-range"></i>
                    Thời gian & Địa điểm
                </h3>

                <div class="form-grid">
                    <div class="form-group">
                        <label>Ngày bắt đầu <span class="required">*</span></label>
                        <InputDate @bind-Value="model.NgayBatDau" class="form-control" />
                        <ValidationMessage For="@(() => model.NgayBatDau)" />
                    </div>

                    <div class="form-group">
                        <label>Ngày kết thúc <span class="required">*</span></label>
                        <InputDate @bind-Value="model.NgayKetThuc" class="form-control" />
                        <ValidationMessage For="@(() => model.NgayKetThuc)" />
                    </div>

                    <div class="form-group full-width">
                        <label>Địa điểm tổ chức <span class="required">*</span></label>
                        <InputText @bind-Value="model.DiaDiem" class="form-control" placeholder="VD: Trung tâm Sát hạch GPLX Đồng Tháp" />
                        <ValidationMessage For="@(() => model.DiaDiem)" />
                    </div>

                    <div class="form-group">
                        <label>Số lượng thí sinh tối đa <span class="required">*</span></label>
                        <InputNumber @bind-Value="model.SoLuongToiDa" class="form-control" min="1" />
                        <ValidationMessage For="@(() => model.SoLuongToiDa)" />
                        <small class="form-text">Số lượng thí sinh tối đa có thể đăng ký</small>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn-secondary" @onclick="GoBack">
                    <i class="bi bi-x-circle"></i>
                    Hủy bỏ
                </button>
                <button type="submit" class="btn-submit" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle"></i>
                        <span>Tạo kỳ thi</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CreateKyThiDTO model = new CreateKyThiDTO();
    private List<HangGiayPhepDTO>? danhSachHang;
    private bool isSubmitting = false;
    [CascadingParameter] public MainLayout? Layout { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await LoadHangGiayPhep();
    }

    private async Task LoadHangGiayPhep()
    {
        try
        {
            Layout.ShowLoading();

            danhSachHang = await Http.GetFromJsonAsync<List<HangGiayPhepDTO>>("api/HangGiayPhep");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Layout.ShowError("Không thể tải danh sách hạng giấy phép!");
        }
        finally
        {
            Layout.HideLoading();
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            Layout.ShowLoading();

            if (model.NgayKetThuc < model.NgayBatDau)
            {
                Layout.ShowWarning("Ngày kết thúc phải sau ngày bắt đầu!");
                return;
            }

            var response = await Http.PostAsJsonAsync("api/KyThi", model);

            if (response.IsSuccessStatusCode)
            {
                Layout.ShowSuccess("Tạo kỳ thi thành công!");
                Navigation.NavigateTo("/ky-thi");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Layout.ShowError($"Lỗi: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Layout.ShowError("Đã xảy ra lỗi khi tạo kỳ thi!");
        }
        finally
        {
            Layout.HideLoading();
        }
    }

    private void GoBack() => Navigation.NavigateTo("/ky-thi");
}
